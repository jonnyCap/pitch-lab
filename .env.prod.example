# =============================================================================
# 🚀 Pitch Lab Production / Cluster Environment Variables (.env.prod)
# Seal with: ./seal-env.sh .env.prod   → k8s/sealed-secret.yaml
# DO NOT COMMIT .env.prod TO GIT!
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Container Registry (GHCR) credentials (for imagePullSecrets: ghcr-creds)
# -----------------------------------------------------------------------------
GHCR_PAT=ghp_your_personal_access_token_with_read_packages
GHCR_USERNAME=jonnycap
GHCR_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# Database (shared PostgreSQL in core-infra; schema isolation via POSTGRES_SCHEMA)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://pitchlab:your_db_password@postgresql.core-infra.svc.cluster.local:5432/pitchlab?sslmode=disable
POSTGRES_SCHEMA=pitchlab

# -----------------------------------------------------------------------------
# Auth: HMAC key for access JWTs (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-64-hex-string-in-production

# -----------------------------------------------------------------------------
# Transactional email (verification / password reset) via Resend — needed from M5
# -----------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=Pitch Lab <noreply@cloud-test.dev>
